{
"Logging": {
  "LogLevel": {
    "Default": "Debug",
    "Microsoft.AspNetCore": "Warning",
    "Microsoft.Hosting.Lifetime": "Information",
    "EtimadScraper.Services": "Debug"
  }
},
  "AllowedHosts": "*",
  "Scraper": {
    "BaseUrl": "https://tenders.etimad.sa/Tender/AllTendersForVisitor",
    "Headless": true,
    "StartPage": 1,
    "MaxPages": 5,
    "PageLoadTimeout": 30000,
    "DelayBetweenPages": 2000,
    "MaxRetryAttempts": 3,
    "OutputFilePath": "tenders.json"
  },
  "Database": {
    "ConnectionString": "Server=localhost;Database=EtimadTenders;Integrated Security=true;TrustServerCertificate=true;",
    "EnableAutoMigration": true
  }
}
