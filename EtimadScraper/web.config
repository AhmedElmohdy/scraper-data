<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>

    <!--
      ASP.NET Core Module v2 — forwards all requests to the Kestrel process.
      stdoutLogEnabled : set to true temporarily to diagnose startup failures.
      stdoutLogFile    : relative to the site root; the folder must exist.
    -->
    <aspNetCore processPath="dotnet"
                arguments=".\EtimadScraper.dll"
                stdoutLogEnabled="false"
                stdoutLogFile=".\logs\stdout"
                hostingModel="inprocess">
      <environmentVariables>
        <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
      </environmentVariables>
    </aspNetCore>

    <!--
      Increase the IIS request timeout to 4 hours (14400 seconds).
      The sync-details endpoint iterates every tender with a 30-second delay
      between each one, so for large datasets the request can run for hours.
    -->
    <httpRuntime executionTimeout="14400" />

    <security>
      <requestFiltering>
        <!-- Allow very large response bodies (scraping payloads). -->
        <requestLimits maxAllowedContentLength="104857600" />
      </requestFiltering>
    </security>

    <modules>
      <!-- Remove the legacy FormsAuthentication module if present. -->
      <remove name="FormsAuthentication" />
    </modules>

    <handlers>
      <!-- Ensure the ASP.NET Core handler is registered. -->
      <add name="aspNetCore"
           path="*"
           verb="*"
           modules="AspNetCoreModuleV2"
           resourceType="Unspecified" />
    </handlers>

  </system.webServer>
</configuration>
